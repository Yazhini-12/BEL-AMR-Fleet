      </uri>

      <name>
        charging_station_04
      </name>

      <pose>
        14.7 -2.8 -0.04 0 0 0
      </pose>

    </include>



    <!-- ================================================== -->
    <!-- CHARGING POINT 05 - EMPTY -->
    <!-- ================================================== -->

    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/Tugbot-charging-station
      </uri>

      <name>
        charging_station_05
      </name>

      <pose>
        14.7 -0.2 -0.04 0 0 0
      </pose>

    </include>



    <!-- ================================================== -->
    <!-- BEL AMR FLEET -->
    <!-- EXACTLY 3 PIONEER 3AT ROBOTS -->
    <!-- ================================================== -->


    <!-- amr_01 -->

    <include>

      <uri>
        model://pioneer_3at
      </uri>

      <name>
        amr_01
      </name>

      <pose>
        13.9 -10.6 0.15 0 0 0
      </pose>

    </include>


    <!-- amr_02 -->

    <include>

      <uri>
        model://pioneer_3at
      </uri>

      <name>
        amr_02
      </name>

      <pose>
        13.9 -8.0 0.15 0 0 0
      </pose>

    </include>


    <!-- amr_03 -->

    <include>

      <uri>
        model://pioneer_3at
      </uri>

      <name>
