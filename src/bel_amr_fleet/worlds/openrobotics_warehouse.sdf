    </include>


    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/pallet_box_mobile
      </uri>

      <name>
        pallet_box
      </name>

      <pose>
        -6.11913 13.7079 0.01 0 0 0
      </pose>

      <static>true</static>

    </include>



    <!-- ================================================== -->
    <!-- LARGE SHELVES -->
    <!-- ================================================== -->


    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf_big
      </uri>

      <name>
