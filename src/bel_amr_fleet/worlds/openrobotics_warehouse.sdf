      <name>
        charging_station_02
      </name>

      <pose>
        14.7 -8.0 -0.04 0 0 0
      </pose>

    </include>



    <!-- ================================================== -->
    <!-- CHARGING POINT 03 -->
    <!-- ================================================== -->

    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/Tugbot-charging-station
      </uri>

      <name>
        charging_station_03
      </name>

      <pose>
        14.7 -5.4 -0.04 0 0 0
      </pose>

    </include>



    <!-- ================================================== -->
    <!-- CHARGING POINT 04 - EMPTY -->
