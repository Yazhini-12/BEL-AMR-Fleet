      </name>

      <pose>
        5.60144 -0.690987 0 0 0 0
      </pose>

    </include>


    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf
      </uri>

      <name>
        shelf_6
      </name>

      <pose>
        5.60144 2.30697 0 0 0 0
      </pose>

    </include>



    <!-- ================================================== -->
    <!-- PALLETS -->
    <!-- ================================================== -->


    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/pallet_box_mobile
      </uri>

      <name>
        pallet_box_mobile
      </name>

      <pose>
        4.4161 14.6952 0.01 0 0 0
      </pose>

    </include>


    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/pallet_box_mobile
      </uri>

      <name>
        pallet_box_mobile_0
      </name>

      <pose>
        4.45415 13.6212 0.01 0 0 0
