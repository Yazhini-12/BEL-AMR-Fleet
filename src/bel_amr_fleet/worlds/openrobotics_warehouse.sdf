    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/cart_model_2
      </uri>

      <name>
        cart1
      </name>

      <pose>
        -5.73 15 0.25 0 0 0
      </pose>

    </include>



    <!-- ================================================== -->
    <!-- WAREHOUSE SHELVES -->
    <!-- ================================================== -->


    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf_big
      </uri>

      <name>
        shelf_big_0
      </name>

      <pose>
        -9.34177 -13.5598 0 0 0 0
      </pose>

    </include>


    <include>

      <uri>
        https://fuel.ignitionrobotics.org/1.0/MovAi/models/shelf
      </uri>

      <name>
