          <pose>0 0 0.8 0 0 0</pose>
          <material>
            <ambient>0.8 0.55 0.05 1</ambient>
            <diffuse>0.8 0.55 0.05 1</diffuse>
          </material>
        </visual>
      </link>

      <pose>-8 3 0 0 0 0</pose>
    </model>

