<?xml version="1.0"?>
<sdf version="1.9">
  <world name="bel_amr_warehouse">

    <!-- =========================
         PHYSICS
         ========================= -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- =========================
         LIGHTING
         ========================= -->
    <light name="warehouse_sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0.5 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <!-- =========================
         GROUND
         ========================= -->
    <model name="warehouse_floor">
      <static>true</static>
      <link name="floor">
        <collision name="collision">
          <geometry>
            <box>
              <size>30 24 0.1</size>
            </box>
          </geometry>
          <pose>0 0 -0.05 0 0 0</pose>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>30 24 0.1</size>
            </box>
          </geometry>
          <pose>0 0 -0.05 0 0 0</pose>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

