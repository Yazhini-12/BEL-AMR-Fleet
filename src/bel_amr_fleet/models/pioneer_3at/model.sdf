<?xml version="1.0" encoding="utf-8"?>

<sdf version="1.7">

    <model name="pioneer3at">

        <pose>0 0 0.45 0 0 0</pose>
        <static>false</static>


        <!-- ================================================== -->
        <!-- CHASSIS -->
        <!-- ================================================== -->

        <link name="chassis">

            <inertial>

                <mass>14.0</mass>

                <inertia>
                    <ixx>0.147116667</ixx>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>

                    <iyy>0.334951167</iyy>
                    <iyz>0.0</iyz>

                    <izz>0.3978345</izz>
                </inertia>

            </inertial>


            <!-- Chassis collision -->

            <collision name="collision">

                <geometry>

                    <box>
                        <size>0.501 0.300 0.19</size>
                    </box>

                </geometry>

            </collision>


            <!-- Chassis visual -->

            <visual name="visual">

                <geometry>

                    <mesh>

                        <uri>
                            https://fuel.gazebosim.org/1.0/openrobotics/models/pioneer%203at/3/files/meshes/chassis.dae
                        </uri>

                        <scale>2.5 2.5 2.5</scale>

                    </mesh>

                </geometry>

            </visual>



            <!-- ================================================== -->
            <!-- SENSOR 1 : 360 DEGREE 2D LIDAR -->
            <!-- ================================================== -->

            <sensor name="lidar" type="gpu_lidar">

                <!-- Mounted on top of robot -->
                <pose>0 0 0.75 0 0 0</pose>

                <always_on>true</always_on>

                <!-- 10 scans per second -->
                <update_rate>10</update_rate>

                <!-- Show laser rays in Gazebo -->
                <visualize>true</visualize>


                <lidar>

                    <scan>

                        <horizontal>

                            <!-- 720 rays -->
                            <samples>720</samples>

                            <resolution>1</resolution>

                            <!-- -180 degrees -->
                            <min_angle>-3.14159265</min_angle>

                            <!-- +180 degrees -->
                            <max_angle>3.14159265</max_angle>

                        </horizontal>

                    </scan>


                    <range>

                        <!-- Minimum LiDAR range -->
                        <min>0.15</min>

                        <!-- Maximum LiDAR range -->
                        <max>20.0</max>

                        <resolution>0.01</resolution>

                    </range>

                </lidar>

            </sensor>



            <!-- ================================================== -->
            <!-- SENSOR 2 : RGB CAMERA -->
            <!-- ================================================== -->

            <sensor name="rgb_camera" type="camera">

                <!--
                    Camera is mounted toward the front of robot.

                    +X is the forward direction of Pioneer.
                -->

                <pose>0.45 0 0.60 0 0 0</pose>

                <always_on>true</always_on>

                <!-- 20 frames per second -->
                <update_rate>20</update_rate>

                <visualize>true</visualize>


                <camera>

                    <!-- Approximately 80 degree horizontal FOV -->

                    <horizontal_fov>
                        1.3962634
                    </horizontal_fov>


                    <image>

                        <width>640</width>

                        <height>480</height>

                        <format>R8G8B8</format>

                    </image>


                    <clip>

                        <near>0.10</near>

                        <far>30.0</far>

                    </clip>

                </camera>

            </sensor>



            <!-- ================================================== -->
            <!-- SENSOR 3 : IMU -->
            <!-- ================================================== -->

            <sensor name="imu" type="imu">

                <!-- IMU near robot centre -->

                <pose>0 0 0.35 0 0 0</pose>

                <always_on>true</always_on>

                <!-- 50 measurements per second -->

                <update_rate>50</update_rate>

            </sensor>


        </link>



        <!-- ================================================== -->
        <!-- RIGHT FRONT WHEEL -->
        <!-- ================================================== -->

        <link name="right_front_wheel">

            <pose>
                0.3125 -0.5025 -0.15 1.5707 0 0
            </pose>


            <inertial>

                <mass>1.5</mass>

                <inertia>

                    <ixx>0.005240625</ixx>
                    <iyy>0.005240625</iyy>
                    <izz>0.009075</izz>

                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>

                </inertia>

            </inertial>


            <collision name="collision">

                <geometry>

                    <cylinder>

                        <radius>0.275</radius>

                        <length>0.1875</length>

                    </cylinder>

                </geometry>


                <surface>

                    <friction>

                        <ode>

                            <mu>1</mu>

                            <mu2>1</mu2>

                            <slip1>0.5</slip1>

                            <slip2>0</slip2>

                        </ode>

                    </friction>

                </surface>

            </collision>


            <visual name="visual">

                <geometry>

                    <mesh>

                        <uri>
                            https://fuel.gazebosim.org/1.0/openrobotics/models/pioneer%203at/3/files/meshes/wheel.dae
                        </uri>

                        <scale>2.5 2.5 2.5</scale>

                    </mesh>

                </geometry>

            </visual>

        </link>



        <!-- ================================================== -->
        <!-- LEFT FRONT WHEEL -->
        <!-- ================================================== -->

        <link name="left_front_wheel">

            <pose>
                0.3125 0.5025 -0.15 1.5707 0 0
            </pose>


            <inertial>

                <mass>1.5</mass>

                <inertia>

                    <ixx>0.005240625</ixx>
                    <iyy>0.005240625</iyy>
                    <izz>0.009075</izz>

                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>

                </inertia>

            </inertial>


            <collision name="collision">

                <geometry>

                    <cylinder>

                        <radius>0.275</radius>

                        <length>0.1875</length>

                    </cylinder>

                </geometry>


                <surface>

                    <friction>

                        <ode>

                            <mu>1</mu>

                            <mu2>1</mu2>

                            <slip1>0.5</slip1>

                            <slip2>0</slip2>

                        </ode>

                    </friction>

                </surface>

            </collision>


            <visual name="visual">

                <geometry>

                    <mesh>

                        <uri>
                            https://fuel.gazebosim.org/1.0/openrobotics/models/pioneer%203at/3/files/meshes/wheel.dae
                        </uri>

                        <scale>2.5 2.5 2.5</scale>

                    </mesh>

                </geometry>

            </visual>

        </link>



        <!-- ================================================== -->
        <!-- RIGHT REAR WHEEL -->
        <!-- ================================================== -->

        <link name="right_rear_wheel">

            <pose>
                -0.3125 -0.5025 -0.15 1.5707 0 0
            </pose>


            <inertial>

                <mass>1.5</mass>

                <inertia>

                    <ixx>0.005240625</ixx>
                    <iyy>0.005240625</iyy>
                    <izz>0.009075</izz>

                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>

                </inertia>

            </inertial>


            <collision name="collision">

                <geometry>

                    <cylinder>

                        <radius>0.275</radius>

                        <length>0.1875</length>

                    </cylinder>

                </geometry>


                <surface>

                    <friction>

                        <ode>

                            <mu>1</mu>

                            <mu2>1</mu2>

                            <slip1>0.5</slip1>

                            <slip2>0</slip2>

                        </ode>

                    </friction>

                </surface>

            </collision>


            <visual name="visual">

                <geometry>

                    <mesh>

                        <uri>
                            https://fuel.gazebosim.org/1.0/openrobotics/models/pioneer%203at/3/files/meshes/wheel.dae
                        </uri>

                        <scale>2.5 2.5 2.5</scale>

                    </mesh>

                </geometry>

            </visual>

        </link>



        <!-- ================================================== -->
        <!-- LEFT REAR WHEEL -->
        <!-- ================================================== -->

        <link name="left_rear_wheel">

            <pose>
                -0.3125 0.5025 -0.15 1.5707 0 0
            </pose>


            <inertial>

                <mass>1.5</mass>

                <inertia>

                    <ixx>0.005240625</ixx>
                    <iyy>0.005240625</iyy>
                    <izz>0.009075</izz>

                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>

                </inertia>

            </inertial>


            <collision name="collision">

                <geometry>

                    <cylinder>

                        <radius>0.275</radius>

                        <length>0.1875</length>

                    </cylinder>

                </geometry>


                <surface>

                    <friction>

                        <ode>

                            <mu>1</mu>

                            <mu2>1</mu2>

                            <slip1>0.5</slip1>

                            <slip2>0</slip2>

                        </ode>

                    </friction>

                </surface>

            </collision>


            <visual name="visual">

                <geometry>

                    <mesh>

                        <uri>
                            https://fuel.gazebosim.org/1.0/openrobotics/models/pioneer%203at/3/files/meshes/wheel.dae
                        </uri>

                        <scale>2.5 2.5 2.5</scale>

                    </mesh>

                </geometry>

            </visual>

        </link>



        <!-- ================================================== -->
        <!-- RIGHT FRONT WHEEL JOINT -->
        <!-- ================================================== -->

        <joint type="revolute" name="right_front">

            <pose>0 0 0 0 0 0</pose>

            <child>right_front_wheel</child>

            <parent>chassis</parent>


            <axis>

                <xyz>0 1 0</xyz>


            </axis>

        </joint>



        <!-- ================================================== -->
        <!-- RIGHT REAR WHEEL JOINT -->
        <!-- ================================================== -->

        <joint type="revolute" name="right_rear">

            <pose>0 0 0 0 0 0</pose>

            <child>right_rear_wheel</child>

            <parent>chassis</parent>


            <axis>

                <xyz>0 1 0</xyz>


            </axis>

        </joint>



        <!-- ================================================== -->
        <!-- LEFT FRONT WHEEL JOINT -->
        <!-- ================================================== -->

        <joint type="revolute" name="left_front">

            <pose>0 0 0 0 0 0</pose>

            <child>left_front_wheel</child>

            <parent>chassis</parent>


            <axis>

                <xyz>0 1 0</xyz>


            </axis>

        </joint>



        <!-- ================================================== -->
        <!-- LEFT REAR WHEEL JOINT -->
        <!-- ================================================== -->

        <joint type="revolute" name="left_rear">

            <pose>0 0 0 0 0 0</pose>

            <child>left_rear_wheel</child>

            <parent>chassis</parent>


            <axis>

                <xyz>0 1 0</xyz>


            </axis>

        </joint>



        <!-- ================================================== -->
        <!-- DIFFERENTIAL DRIVE -->
        <!-- WHEEL-BASED ODOMETRY -->
        <!-- ================================================== -->

        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">

            <!-- Left wheel joints -->

            <left_joint>
                left_front
            </left_joint>

            <left_joint>
                left_rear
            </left_joint>


            <!-- Right wheel joints -->

            <right_joint>
                right_front
            </right_joint>

            <right_joint>
                right_rear
            </right_joint>


            <!--
                Scaled Pioneer dimensions.
                Robot was enlarged 2.5x.
            -->

            <wheel_separation>
                0.9525
            </wheel_separation>

            <wheel_radius>
                0.2775
            </wheel_radius>


            <!-- Publish wheel odometry at 30 Hz -->

            <odom_publish_frequency>
                30
            </odom_publish_frequency>

        </plugin>



        <!-- ================================================== -->
        <!-- WHEEL ENCODER / JOINT STATE PUBLISHER -->
        <!-- ================================================== -->

        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">

            <!-- Left front wheel encoder -->
            <joint_name>
                left_front
            </joint_name>

            <!-- Left rear wheel encoder -->
            <joint_name>
                left_rear
            </joint_name>

            <!-- Right front wheel encoder -->
            <joint_name>
                right_front
            </joint_name>

            <!-- Right rear wheel encoder -->
            <joint_name>
                right_rear
            </joint_name>

        </plugin>


    </model>

</sdf>